<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="disease_flu" model="hr.hospital.disease">
        <field name="name">Грип</field>
        <field name="description">Заразне респіраторне захворювання, спричинене вірусами грипу.</field>
    </record>

    <record id="disease_hypertension" model="hr.hospital.disease">
        <field name="name">Гіпертонія</field>
        <field name="description">Хронічно підвищений артеріальний тиск вище норми.</field>
    </record>

    <record id="disease_diabetes" model="hr.hospital.disease">
        <field name="name">Цукровий діабет</field>
        <field name="description">Метаболічне захворювання, що характеризується високим рівнем цукру в крові.</field>
    </record>

</odoo>
