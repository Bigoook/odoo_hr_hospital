<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="disease_flu" model="hr.hospital.disease">
        <field name="name">Influenza (Flu)</field>
        <field name="description">Contagious respiratory illness caused by influenza viruses.</field>
    </record>

    <record id="disease_hypertension" model="hr.hospital.disease">
        <field name="name">Hypertension</field>
        <field name="description">Chronically elevated blood pressure above normal levels.</field>
    </record>

    <record id="disease_diabetes" model="hr.hospital.disease">
        <field name="name">Diabetes Mellitus</field>
        <field name="description">Metabolic disease characterized by high blood sugar levels.</field>
    </record>

</odoo>
