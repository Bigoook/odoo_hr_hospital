<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="birth_date"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="doctor_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_create_quick_visit" type="object"
                            string="New Visit" class="btn-primary"/>
                    <button name="action_view_visit_history" type="object"
                            string="Visits History" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Personal Information">
                            <field name="name"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Medical">
                            <field name="blood_type"/>
                            <field name="insurance_number"/>
                            <field name="doctor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Doctor History">
                            <field name="history_ids" context="{'active_test': False}">
                                <list editable="bottom">
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" string="Patient" filter_domain="[('name', 'ilike', self)]"/>
                <field name="phone" string="Phone" filter_domain="[('phone', 'ilike', self)]"/>
                <field name="doctor_id"/>
                <filter string="By Personal Doctor" name="groupby_doctor" context="{'group_by': 'doctor_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
