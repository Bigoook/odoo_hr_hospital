<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.list</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="is_intern"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <group>
                        <group string="Personal Information">
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Medical Information">
                            <field name="category_id"/>
                            <field name="is_intern" readonly="1"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"
                                   domain="[('is_intern', '=', False), ('id', '!=', id)]"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patients">
                            <field name="patient_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="birth_date"/>
                                    <field name="gender"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="patient_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Interns" invisible="not intern_ids">
                            <field name="intern_ids">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex flex-column">
                                                <strong><field name="name"/></strong>
                                                <span><field name="specialty"/></span>
                                                <span><field name="phone"/></span>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.search</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search string="Doctors">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <filter string="Mentors" name="filter_mentors" domain="[('intern_ids', '!=', False)]"/>
                <filter string="Interns" name="filter_interns" domain="[('is_intern', '=', True)]"/>
                <separator/>
                <filter string="Category" name="groupby_category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.kanban</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" quick_create="true">
                <field name="intern_ids"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" t-if="widget.editable" type="open" class="dropdown-item">Edit</a>
                        <a role="menuitem" t-if="widget.deletable" type="delete" class="dropdown-item">Delete</a>
                    </t>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <strong><field name="name"/></strong>
                            <span><field name="specialty"/></span>
                            <span class="text-muted">
                                <field name="category_id"/>
                            </span>
                            <span><field name="phone"/></span>
                            <span><field name="email"/></span>
                        </div>
                        <div t-if="record.intern_ids.raw_value.length" class="mt-2">
                            <strong>Interns:</strong>
                            <field name="intern_ids" widget="many2many_tags"/>
                        </div>
                        <footer>
                            <a type="object" name="action_create_quick_visit" class="btn btn-primary">
                                New Visit
                            </a>
                            <div class="oe_kanban_bottom_right ms-auto">
                                <a type="open" class="btn btn-secondary">Edit</a>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
