<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_doctor_history_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.tree</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list string="Doctor History">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.form</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form string="Doctor History">
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="assignment_date"/>
                        <field name="change_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_history_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.search</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <search string="Doctor History">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_doctor_history" model="ir.actions.act_window">
        <field name="name">Doctor History</field>
        <field name="res_model">hr.hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
