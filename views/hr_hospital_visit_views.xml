<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_visit_list" model="ir.ui.view">
        <field name="name">hr.hospital.visit.list</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list string="Visits">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="scheduled_date"/>
                <field name="actual_date"/>
                <field name="disease_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form string="Visit">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_same_disease_visits" type="object"
                                class="oe_stat_button" icon="fa-stethoscope"
                                invisible="not disease_id">
                            <field name="same_disease_visit_count" widget="statinfo" string="Same Diagnosis"/>
                        </button>
                    </div>
                    <group>
                        <group string="Visit Details">
                            <field name="patient_id"/>
                            <field name="doctor_id" readonly="state == 'done'"/>
                            <field name="scheduled_date" readonly="state == 'done'"/>
                            <field name="actual_date" readonly="state == 'done'"/>
                        </group>
                        <group string="Diagnosis">
                            <field name="disease_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                        <page string="Epicrisis">
                            <field name="epicrisis" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visits" date_start="scheduled_date" color="doctor_id" mode="month">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Visits">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                <searchpanel>
                    <field name="doctor_id" icon="fa-user-md" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_hr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits by Doctor and Status">
                <field name="doctor_id" type="row"/>
                <field name="scheduled_date" interval="month" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_hr_hospital_visit_graph" model="ir.ui.view">
        <field name="name">hr.hospital.visit.graph</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits by Month" type="bar" stacked="1">
                <field name="scheduled_date" interval="month" type="row"/>
                <field name="disease_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_hr_hospital_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
    </record>

    <record id="action_hr_hospital_visit_pivot" model="ir.actions.act_window">
        <field name="name">Visits Pivot (Current Year)</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_hr_hospital_visit_pivot"/>
        <field name="domain">[('scheduled_date', '&gt;=', context_today().strftime('%Y-01-01 00:00:00')), ('scheduled_date', '&lt;=', context_today().strftime('%Y-12-31 23:59:59'))]</field>
    </record>


</odoo>
